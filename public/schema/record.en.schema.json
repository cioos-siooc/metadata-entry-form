    "progress": {
      "type": "string",
      "enum": [
        "",
        "onGoing",
        "historicalArchive",
        "completed"
      ],
      "title": "Dataset status",
      "description": "ISO 19115 MD_ProgressCode.",
      "x-cioos-tab": "dataID",
      "x-cioos-error": {
        "en": "Please select a dataset status",
        "fr": "Veuillez définir le statut du jeu de données"
      }
    },
    "language": {
      "type": "string",
      "enum": [
        "",
        "en",
        "fr"
      ],
      "title": "Primary language",
      "description": "The dataset's primary language.",
      "x-cioos-tab": "dataID",
      "x-cioos-error": {
        "en": "Language field is missing",
        "fr": "Le champ de langue est vide"
      }
    },
    "license": {
      "type": "string",
      "enum": [
        "",
        "CC-BY-4.0",
        "CC-BY-SA-4.0",
        "CC-BY-ND-4.0",
        "CC-BY-NC-4.0",
        "CC-BY-NC-SA-4.0",
        "CC-BY-NC-ND-4.0",
        "CC0",
        "government-open-license-canada",
        "government-open-license-nova-scotia",
        "OGL-NB",
        "OGL-BC",
        "government-open-license-newfoundland",
        "Apache-2.0",
        "No License",
        "ca-eccc-odl"
      ],
      "title": "Licence",
      "description": "Licence under which the dataset is released.",
      "x-cioos-tab": "dataID",
      "x-cioos-error": {
        "en": "Please select a license for the dataset",
        "fr": "Veuillez sélectionner une licence pour le jeu de données"
      }
    },
    "projects": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "title": "Projects",
      "description": "Project names, from the region's admin-managed list.",
      "x-cioos-tab": "dataID"
    },
    "dateStart": {
      "$ref": "#/definitions/isoDateTime",
      "title": "Start date",
      "description": "Start of the dataset's temporal extent.",
      "x-cioos-tab": "dataID"
    },
    "dateEnd": {
      "$ref": "#/definitions/isoDateTime",
      "title": "End date",
      "description": "End of the dataset's temporal extent.",
      "x-cioos-tab": "dataID"
    },
    "datePublished": {
      "$ref": "#/definitions/isoDateTime",
      "title": "Date published",
      "description": "Publication date.",
      "x-cioos-tab": "dataID"
    },
    "dateRevised": {
      "$ref": "#/definitions/isoDateTime",
      "title": "Date revised",
      "description": "Most recent revision date.",
      "x-cioos-tab": "dataID"
    },
    "edition": {
      "type": "string",
      "title": "Edition",
      "description": "Dataset edition or version label.",
      "x-cioos-tab": "dataID"
    },
    "limitations": {
