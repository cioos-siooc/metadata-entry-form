          "hardCoralCoverAndComposition",
          "seagrassCoverAndComposition",
          "macroalgalCanopyCoverAndComposition",
          "invertebrateAbundanceAndDistribution",
          "microbeBiomassAndDiversity",
          "oceanColour",
          "oceanSound",
          "marineDebris",
          "oceanSurfaceHeatFlux",
          "oceanSurfaceStress",
          "oceanBottomPressure"
