{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://schema.cioos.ca/metadata-entry-form/v1/record.schema.json",
  "title": "Enregistrement de métadonnées du SIOOC",
  "description": "Description structurelle d'un enregistrement de métadonnées du SIOOC : types, formes et vocabulaires contrôlés. Décrit l'objet JavaScript normalisé, et non le JSON brut de la base de données en temps réel.",
  "x-cioos-schema-version": "1.0.0",
  "type": "object",
  "additionalProperties": true,
  "definitions": {
    "numericString": {
      "type": [
        "string",
        "number"
      ],
      "pattern": "^(-?\\d+(\\.\\d+)?)?$",
      "description": "Un nombre stocké sous forme de chaîne, ou « » si non défini. Les valeurs de cadre de délimitation et d'étendue verticale sont des chaînes dans la base de données."
    },
    "numericStringRequired": {
      "type": [
        "string",
        "number"
      ],
      "pattern": "^-?\\d+(\\.\\d+)?$",
      "description": "Un nombre stocké sous forme de chaîne."
    },
    "isoDateTime": {
      "type": [
        "string",
        "null"
      ],
      "description": "Date-heure ISO-8601 complète avec millisecondes, p. ex. 2023-10-01T19:00:00.000Z."
    },
    "translationProvenance": {
      "type": "object",
      "properties": {
        "verified": {
          "type": "boolean"
        },
        "message": {
          "type": "string"
        }
      },
      "required": [
        "verified"
      ]
    },
    "translations": {
      "type": "object",
      "properties": {
        "en": {
          "$ref": "#/definitions/translationProvenance"
        },
        "fr": {
          "$ref": "#/definitions/translationProvenance"
        }
      },
      "additionalProperties": false
    },
    "bilingualText": {
      "type": "object",
      "properties": {
        "en": {
          "type": "string"
        },
        "fr": {
          "type": "string"
        },
        "translations": {
          "$ref": "#/definitions/translations"
        }
      },
      "description": "Texte libre en anglais et en français, avec la provenance de la traduction."
    },
    "bilingualTextRequired": {
      "allOf": [
        {
          "$ref": "#/definitions/bilingualText"
        },
        {
          "required": [
            "en",
            "fr"
          ],
          "properties": {
            "en": {
              "minLength": 1
            },
            "fr": {
              "minLength": 1
            }
          }
        }
      ]
    },
    "bilingualTextAtLeastOne": {
      "allOf": [
        {
          "$ref": "#/definitions/bilingualText"
        },
        {
          "anyOf": [
            {
              "required": [
                "en"
              ],
              "properties": {
                "en": {
                  "minLength": 1
                }
              }
            },
            {
              "required": [
                "fr"
              ],
              "properties": {
                "fr": {
                  "minLength": 1
                }
              }
            }
          ]
        }
      ]
    },
    "bilingualKeywords": {
      "type": "object",
      "properties": {
        "en": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "fr": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      }
    },
    "emailOrEmpty": {
      "type": "string",
      "anyOf": [
        {
          "const": ""
        },
        {
          "format": "email"
        }
      ]
    },
    "uriOrEmpty": {
      "type": "string",
      "anyOf": [
        {
          "const": ""
        },
        {
          "format": "uri"
        }
      ]
    },
    "mapExtent": {
      "type": "object",
      "properties": {
        "north": {
          "$ref": "#/definitions/numericString"
        },
        "south": {
          "$ref": "#/definitions/numericString"
        },
        "east": {
          "$ref": "#/definitions/numericString"
        },
        "west": {
          "$ref": "#/definitions/numericString"
        },
        "polygon": {
          "type": "string",
          "description": "Paires « lat,lon » séparées par des espaces ; au moins deux points, et la première paire doit être identique à la dernière."
        },
        "description": {
          "$ref": "#/definitions/bilingualText"
        }
      }
    },
    "contact": {
      "type": "object",
      "properties": {
        "role": {
          "type": "array",
          "items": {
            "enum": [
              "custodian",
              "owner",
              "distributor",
              "author",
              "coAuthor",
              "collaborator",
              "contributor",
              "editor",
              "funder",
              "mediator",
              "originator",
              "pointOfContact",
              "principalInvestigator",
              "processor",
              "publisher",
              "resourceProvider",
              "rightsHolder",
              "sponsor",
              "stakeholder"
            ]
          },
          "description": "Valeurs ISO 19115 CI_RoleCode."
        },
        "orgName": {
          "type": "string"
        },
        "orgEmail": {
          "$ref": "#/definitions/emailOrEmpty"
        },
        "orgURL": {
          "$ref": "#/definitions/uriOrEmpty"
        },
        "orgAdress": {
          "type": "string"
        },
        "orgCity": {
          "type": "string"
        },
        "orgCountry": {
          "type": "string"
        },
        "orgRor": {
          "type": "string"
        },
        "indPosition": {
          "type": "string"
        },
        "indEmail": {
          "$ref": "#/definitions/emailOrEmpty"
        },
        "indOrcid": {
          "type": "string"
        },
        "givenNames": {
          "type": "string"
        },
        "lastName": {
          "type": "string"
        },
        "inCitation": {
          "type": "boolean"
        },
        "contactID": {
          "type": "string"
        }
      }
    },
    "contactFilled": {
      "allOf": [
        {
          "$ref": "#/definitions/contact"
        },
        {
          "required": [
            "role"
          ],
          "properties": {
            "role": {
              "minItems": 1
            }
          },
          "anyOf": [
            {
              "required": [
                "orgName"
              ],
              "properties": {
                "orgName": {
                  "minLength": 1
                }
              }
            },
            {
              "required": [
                "givenNames"
              ],
              "properties": {
                "givenNames": {
                  "minLength": 1
                }
              }
            },
            {
              "required": [
                "lastName"
              ],
              "properties": {
                "lastName": {
                  "minLength": 1
                }
              }
            }
          ]
        }
      ]
    },
    "instrument": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string"
        },
        "manufacturer": {
          "type": "string"
        },
        "version": {
          "type": "string"
        },
        "type": {
          "$ref": "#/definitions/bilingualText"
        },
        "description": {
          "$ref": "#/definitions/bilingualText"
        },
        "platform": {
          "type": "string"
        },
        "instrumentID": {
          "type": "string"
        }
      }
    },
