# Frontend (Vite) environment. Backend env lives in deploy/.env (compose) and
# server/.env.sample (running the API on the host).

# API base URL. Default "/api" assumes same-origin (Vite dev proxy or nginx).
# Authentication is served by the API under /api/v1/auth.
# VITE_API_BASE_URL=/api

# Authentication providers (set to "false" to disable, enabled by default).
# These toggle the sign-in buttons; the OAuth clients themselves are configured
# on the API (deploy/.env: OAUTH_* client id/secret).
VITE_AUTH_MICROSOFT=true
VITE_AUTH_ORCID=true
# Show the email/password sign-in + registration form. The seeded dev users are
# author/reviewer/admin@example.org, password "password".
VITE_AUTH_LOCAL=true

# Base path for sub-path hosting (default "/")
# VITE_BASE_PATH=/

# Marks a non-production deployment (shows the dev banner)
VITE_DEV_DEPLOYMENT=false

# Dev proxy target (default shown; used by vite.config.js server.proxy)
# VITE_API_PROXY_TARGET=http://localhost:3001
