# Frontend (Vite) environment. Backend env lives in deploy/.env (compose) and
# server/.env.sample (running the API on the host).

# API base URL. Default "/api" assumes same-origin (Vite dev proxy or nginx).
# VITE_API_BASE_URL=/api

# Keycloak. Defaults: url=/auth (same-origin proxy), realm=cioos,
# clientId=metadata-form. In local dev the SPA talks to Keycloak directly:
VITE_KEYCLOAK_URL=http://localhost:8080/auth
# VITE_KEYCLOAK_REALM=cioos
# VITE_KEYCLOAK_CLIENT_ID=metadata-form

# Authentication providers (set to "false" to disable, enabled by default)
VITE_AUTH_MICROSOFT=true
VITE_AUTH_ORCID=true
# Show a "sign in with local account" button (Keycloak username/password
# users — the dev realm ships dev-author/dev-reviewer/dev-admin, password "dev")
VITE_AUTH_LOCAL=true

# Base path for sub-path hosting (default "/")
# VITE_BASE_PATH=/

# Marks a non-production deployment (shows the dev banner)
VITE_DEV_DEPLOYMENT=false

# Dev proxy targets (defaults shown; used by vite.config.js server.proxy)
# VITE_API_PROXY_TARGET=http://localhost:3001
# VITE_AUTH_PROXY_TARGET=http://localhost:8080
