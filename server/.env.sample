# --- Core ---
PORT=3001
DATABASE_URL=postgres://cioos:cioos@localhost:5432/cioos_metadata
LOG_LEVEL=info

# --- Authentication (the API issues its own tokens) ---
# Public origin of the SPA; used as the token issuer, OAuth redirect base, and
# email-link origin. Defaults to http://localhost:3000 if unset.
SPA_URL=http://localhost:3000
# RS256 signing keypair. If unset outside production, an ephemeral dev keypair
# is generated at boot (sessions reset on restart). Generate real keys:
#   openssl genrsa -out jwt.key 2048 && openssl rsa -in jwt.key -pubout -out jwt.pub
# Accepts raw PEM or (recommended for env/UI) base64: base64 -w0 jwt.key
# JWT_PRIVATE_KEY=
# JWT_PUBLIC_KEY=
COOKIE_SECURE=false
COOKIE_SAMESITE=lax
# Social login (leave blank to disable a provider). Register the callback
# <SPA_URL or API_URL>/api/v1/auth/oauth/<provider>/callback with each provider.
# OAUTH_GOOGLE_CLIENT_ID=
# OAUTH_GOOGLE_CLIENT_SECRET=
# OAUTH_MICROSOFT_CLIENT_ID=
# OAUTH_MICROSOFT_CLIENT_SECRET=
# OAUTH_ORCID_CLIENT_ID=
# OAUTH_ORCID_CLIENT_SECRET=

# --- Secrets ---
# 64 hex chars (32 bytes) — encrypts per-region DataCite/GitHub credentials at rest.
# Generate with: openssl rand -hex 32
CREDENTIALS_ENC_KEY=

# --- Email (any SMTP server; Gmail app-password works) ---
SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
SMTP_FROM=cioos.metadata.notifications@example.org

# --- External services ---
COHERE_API_KEY=
# GitHub token used to open review issues for the hakai region
GITHUB_AUTH=

# --- Internal services ---
CONVERTER_URL=http://localhost:8000
