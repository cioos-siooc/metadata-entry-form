# --- Core ---
PORT=3001
DATABASE_URL=postgres://cioos:cioos@localhost:5432/cioos_metadata
LOG_LEVEL=info

# --- Keycloak ---
# Issuer as it appears in tokens (public URL)
KEYCLOAK_ISSUER=http://localhost:8080/auth/realms/cioos
# URL the API uses to reach Keycloak (differs from issuer inside docker)
# KEYCLOAK_INTERNAL_ISSUER=http://keycloak:8080/auth/realms/cioos
KEYCLOAK_AUDIENCE=metadata-form

# --- Secrets ---
# 64 hex chars (32 bytes) — encrypts per-region DataCite/GitHub credentials at rest.
# Generate with: openssl rand -hex 32
CREDENTIALS_ENC_KEY=

# --- Email (any SMTP server; Gmail app-password works) ---
SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
SMTP_FROM=cioos.metadata.notifications@example.org

# --- External services ---
COHERE_API_KEY=
# GitHub token used to open review issues for the hakai region
GITHUB_AUTH=

# --- Internal services ---
CONVERTER_URL=http://localhost:8000
