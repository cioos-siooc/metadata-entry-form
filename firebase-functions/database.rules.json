{
  "rules": {
    // Firebase security rules cascade, meaning that if a user is granted read or write permissions
    // at a higher (parent) level, those permissions cannot be revoked at a lower (child) level.
    // This design requires careful structuring of rules (and data) to ensure appropriate access control
    // throughout the database hierarchy.
    "$region": {
      // Allow read access to any authenticated user.
      ".read": "auth.uid != null",
      // 'shares' is the reverse index backing the "Shared with me" page. It is written
      // only by the shareRecord/unshareRecord cloud functions (the admin SDK bypasses
      // these rules), so clients get no write access at all.
      "shares": {
        "$userid": {
          ".write": false
        }
      },
      // Automated review runs, written by review_region (admin SDK). Clients may only stop one.
      "qaRuns": {
        "$runid": {
          "cancel": {
            // Only an existing run: 'active' and 'last' are pointers, not runs.
            ".write": "root.child($region).child('qaRuns').child($runid).child('status').exists() && ((',' + root.child('admin').child($region).child('permissions').child('reviewers').val().replace(' ', '').toLowerCase() + ',').contains(',' + auth.token.email.toLowerCase() + ',') || (',' + root.child('admin').child($region).child('permissions').child('admins').val().replace(' ', '').toLowerCase() + ',').contains(',' + auth.token.email.toLowerCase() + ','))",
            ".validate": "newData.val() === true"
          }
        }
      },
      "users": {
        "$userid": {
          // Allow write access if the authenticated user is the user specified by $userid or if the authenticated user's email is listed as a reviewer in the admin permissions for the region.
          ".write": "(auth.uid == $userid) || (root.child('admin').child($region).child('permissions').child('reviewers').isString() && (',' + root.child('admin').child($region).child('permissions').child('reviewers').val().replace(' ', '').toLowerCase() + ',').contains(',' + auth.token.email.toLowerCase() + ','))",
          "records": {
            "$recordid": {
              // Allow read access if the authenticated users's uid exists in the 'shared with' object for the record
              ".read": "root.child($region).child('users').child($userid).child('records').child($recordid).child('sharedWith').child(auth.uid).exists()",
              // Allow write access if the authenticated users's uid exists in the 'shared with' object for the record
              ".write": "root.child($region).child('users').child($userid).child('records').child($recordid).child('sharedWith').child(auth.uid).exists()",
              // Automated review results. Written only by the review_record/review_region
              // functions (admin SDK). The writes granted above cascade, so .validate blocks them.
              "qa": {
                "findings": { ".validate": false },
                "suggested": { ".validate": false }, // legacy record-wide merge; cleared on review
                "inputHash": { ".validate": false },
                "generated": { ".validate": false },
                "checked": { ".validate": false },
                // A reviewer's decision on a finding: {status: applied|deferred|rejected, note?}
                "statuses": {
                  ".write": "(',' + root.child('admin').child($region).child('permissions').child('admins').val().replace(' ', '').toLowerCase() + ',').contains(',' + auth.token.email.toLowerCase() + ',')",
                  "$findingid": {
                    ".validate": "(',' + root.child('admin').child($region).child('permissions').child('reviewers').val().replace(' ', '').toLowerCase() + ',').contains(',' + auth.token.email.toLowerCase() + ',') || (',' + root.child('admin').child($region).child('permissions').child('admins').val().replace(' ', '').toLowerCase() + ',').contains(',' + auth.token.email.toLowerCase() + ',')"
                  }
                }
              }
            }
          }
        }
      }
    },
    // Pending share invitations, keyed by email address. Server-only: it holds the
    // email addresses of people who don't have accounts yet. This must be a named
    // top-level node, not a child of a region - a named child takes precedence over
    // the "$region" wildcard, whose ".read" would otherwise cascade down and cannot
    // be revoked lower in the tree.
    "invites": {
      ".read": false,
      ".write": false
    },
    // LLM call cache for the automated review functions. Server-only, and top-level for the
    // same reason as 'invites'.
    "reviewerCache": {
      ".read": false,
      ".write": false
    },
    "admin": {
      // Section of the database dedicated to admin configurations.
      //
      // admins and reviewers are comma-separated email lists. Membership is an exact,
      // case-insensitive match on a whole entry (spaces stripped), so "booth@cioos.ca" does
      // not match "colton.booth@cioos.ca".
      "$regionAdmin": {
        // Only the region's admins can change its configuration (permissions, credentials,
        // ...). A region with no admins list is bootstrapped from the Firebase console.
        ".write": "(root.child('admin').child($regionAdmin).child('permissions').child('admins').isString() && (',' + root.child('admin').child($regionAdmin).child('permissions').child('admins').val().replace(' ', '').toLowerCase() + ',').contains(',' + auth.token.email.toLowerCase() + ','))",
        // Reviewers and admins can read the region's configuration.
        ".read": "(root.child('admin').child($regionAdmin).child('permissions').child('reviewers').isString() && (',' + root.child('admin').child($regionAdmin).child('permissions').child('reviewers').val().replace(' ', '').toLowerCase() + ',').contains(',' + auth.token.email.toLowerCase() + ',')) || (root.child('admin').child($regionAdmin).child('permissions').child('admins').isString() && (',' + root.child('admin').child($regionAdmin).child('permissions').child('admins').val().replace(' ', '').toLowerCase() + ',').contains(',' + auth.token.email.toLowerCase() + ','))",
        "projects": {
          // Reviewers can also manage the region's projects.
          ".write": "(root.child('admin').child($regionAdmin).child('permissions').child('reviewers').isString() && (',' + root.child('admin').child($regionAdmin).child('permissions').child('reviewers').val().replace(' ', '').toLowerCase() + ',').contains(',' + auth.token.email.toLowerCase() + ','))",
          // Allow read access to any authenticated user.
          ".read": "auth.uid != null"
        },
        "permissions": {
          // Any authenticated user can see who the region's admins and reviewers are.
          ".read": "auth.uid != null"
        }
      }
    }
  }
}
