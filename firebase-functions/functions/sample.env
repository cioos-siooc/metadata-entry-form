# DATACITE_AUTH_HASH is the base64 encoded string of the userid:password
DATACITE_AUTH_HASH=
COHERE_API_KEY=
GITHUB_AUTH=
# Gmail account used to send notification, review and record-sharing emails.
# Can be left blank for local development.
GMAIL_USER=
GMAIL_PASS=
# cioos-metadata-reviewer review API (POST {url}/review) and its shared bearer token.
# Leave blank to disable the "Run automated review" button's backend.
REVIEWER_API_URL=
REVIEWER_API_TOKEN=
