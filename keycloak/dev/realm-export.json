{
  "realm": "cioos",
  "enabled": true,
  "displayName": "CIOOS Metadata Entry Form",
  "registrationAllowed": false,
  "loginWithEmailAllowed": true,
  "duplicateEmailsAllowed": false,
  "verifyEmail": false,
  "sslRequired": "none",
  "clients": [
    {
      "clientId": "metadata-form",
      "name": "CIOOS Metadata Entry Form SPA",
      "enabled": true,
      "publicClient": true,
      "standardFlowEnabled": true,
      "directAccessGrantsEnabled": true,
      "fullScopeAllowed": true,
      "redirectUris": [
        "http://localhost:3000/*",
        "${env.PUBLIC_URL:http://localhost}/*"
      ],
      "webOrigins": [
        "+"
      ],
      "attributes": {
        "pkce.code.challenge.method": "S256",
        "post.logout.redirect.uris": "+"
      },
      "protocolMappers": [
        {
          "name": "metadata-form-audience",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-audience-mapper",
          "consentRequired": false,
          "config": {
            "included.client.audience": "metadata-form",
            "id.token.claim": "false",
            "access.token.claim": "true"
          }
        }
      ]
    }
  ],
  "identityProviders": [
    {
      "alias": "google",
      "displayName": "Google",
      "providerId": "google",
      "enabled": false,
      "trustEmail": true,
      "firstBrokerLoginFlowAlias": "first broker login",
      "config": {
        "clientId": "REPLACE_GOOGLE_CLIENT_ID",
        "clientSecret": "REPLACE_GOOGLE_CLIENT_SECRET",
        "prompt": "select_account"
      }
    },
    {
      "alias": "microsoft",
      "displayName": "Microsoft",
      "providerId": "microsoft",
      "enabled": false,
      "trustEmail": true,
      "firstBrokerLoginFlowAlias": "first broker login",
      "config": {
        "clientId": "REPLACE_MICROSOFT_CLIENT_ID",
        "clientSecret": "REPLACE_MICROSOFT_CLIENT_SECRET",
        "prompt": "select_account"
      }
    },
    {
      "alias": "orcid",
      "displayName": "ORCID",
      "providerId": "oidc",
      "enabled": false,
      "trustEmail": false,
      "firstBrokerLoginFlowAlias": "first broker login",
      "config": {
        "issuer": "https://orcid.org",
        "authorizationUrl": "https://orcid.org/oauth/authorize",
        "tokenUrl": "https://orcid.org/oauth/token",
        "jwksUrl": "https://orcid.org/oauth/jwks",
        "userInfoUrl": "https://orcid.org/oauth/userinfo",
        "validateSignature": "true",
        "useJwksUrl": "true",
        "clientId": "REPLACE_ORCID_CLIENT_ID",
        "clientSecret": "REPLACE_ORCID_CLIENT_SECRET",
        "defaultScope": "openid email",
        "prompt": "login"
      }
    }
  ],
  "users": [
    {
      "username": "dev-author",
      "enabled": true,
      "email": "author@example.org",
      "emailVerified": true,
      "firstName": "Devon",
      "lastName": "Author",
      "credentials": [
        {
          "type": "password",
          "value": "dev",
          "temporary": false
        }
      ]
    },
    {
      "username": "dev-reviewer",
      "enabled": true,
      "email": "reviewer@example.org",
      "emailVerified": true,
      "firstName": "Rae",
      "lastName": "Reviewer",
      "credentials": [
        {
          "type": "password",
          "value": "dev",
          "temporary": false
        }
      ]
    },
    {
      "username": "dev-admin",
      "enabled": true,
      "email": "admin@example.org",
      "emailVerified": true,
      "firstName": "Ada",
      "lastName": "Admin",
      "credentials": [
        {
          "type": "password",
          "value": "dev",
          "temporary": false
        }
      ]
    }
  ]
}