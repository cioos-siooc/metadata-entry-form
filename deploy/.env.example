# Copy to deploy/.env and fill in. Used by docker-compose.yml services.

# --- Public URL of this deployment (no trailing slash) ---
# Also used as the OAuth redirect base and the origin for email links.
PUBLIC_URL=http://localhost

# --- Postgres (app database) ---
POSTGRES_DB=cioos_metadata
POSTGRES_USER=cioos
POSTGRES_PASSWORD=change-me

# --- API ---
DATABASE_URL=postgres://cioos:change-me@postgres:5432/cioos_metadata
# openssl rand -hex 32
CREDENTIALS_ENC_KEY=

# --- Authentication (the API issues its own tokens) ---
# RS256 signing keypair (PEM). Generate:
#   openssl genrsa -out jwt.key 2048
#   openssl rsa -in jwt.key -pubout -out jwt.pub
# Paste the PEM contents; \n-escaped single lines are also accepted.
JWT_PRIVATE_KEY=
JWT_PUBLIC_KEY=
# Cookie flags for the refresh/OAuth cookies. Keep secure=true behind HTTPS.
COOKIE_SECURE=true
COOKIE_SAMESITE=lax

# --- Social login (OAuth/OIDC). Leave a pair blank to disable that provider. ---
# Register the callback URL with each provider:
#   <PUBLIC_URL>/api/v1/auth/oauth/<google|microsoft|orcid>/callback
OAUTH_GOOGLE_CLIENT_ID=
OAUTH_GOOGLE_CLIENT_SECRET=
OAUTH_MICROSOFT_CLIENT_ID=
OAUTH_MICROSOFT_CLIENT_SECRET=
# The multi-tenant `common` issuer contains a placeholder; point at a concrete
# tenant (a tenant GUID, or `organizations`/`consumers`) if login rejects the token.
OAUTH_MICROSOFT_DISCOVERY_URL=https://login.microsoftonline.com/common/v2.0/.well-known/openid-configuration
OAUTH_ORCID_CLIENT_ID=
OAUTH_ORCID_CLIENT_SECRET=

# Emails treated as superadmins (comma-separated), plus the superadmins table.
SUPERADMIN_EMAILS=

# --- Email (any SMTP server) ---
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
SMTP_FROM=

# --- External services ---
COHERE_API_KEY=
GITHUB_AUTH=

# --- Image tag for pulls (CI publishes to GHCR) ---
TAG=latest
