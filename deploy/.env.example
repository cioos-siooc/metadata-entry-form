# Copy to deploy/.env and fill in. Used by docker-compose.yml services.

# --- Public URL of this deployment (no trailing slash) ---
PUBLIC_URL=http://localhost

# --- Postgres (app database; a keycloak database is created automatically) ---
POSTGRES_DB=cioos_metadata
POSTGRES_USER=cioos
POSTGRES_PASSWORD=change-me

# --- Keycloak ---
KC_DB_USERNAME=cioos
KC_DB_PASSWORD=change-me
KC_BOOTSTRAP_ADMIN_USERNAME=admin
KC_BOOTSTRAP_ADMIN_PASSWORD=change-me

# --- API ---
DATABASE_URL=postgres://cioos:change-me@postgres:5432/cioos_metadata
# Must be <PUBLIC_URL>/auth/realms/cioos (env files are not interpolated — write it out)
KEYCLOAK_ISSUER=http://localhost/auth/realms/cioos
KEYCLOAK_AUDIENCE=metadata-form
# openssl rand -hex 32
CREDENTIALS_ENC_KEY=

# --- Email (any SMTP server) ---
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
SMTP_FROM=

# --- External services ---
COHERE_API_KEY=
GITHUB_AUTH=

# --- Image tag for pulls (CI publishes to GHCR) ---
TAG=latest
