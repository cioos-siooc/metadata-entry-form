# Multi-stage build: Vite build -> nginx serving the SPA + reverse proxy.
FROM node:22-alpine AS build

WORKDIR /app
COPY package.json package-lock.json .npmrc ./
COPY scripts ./scripts
# postinstall needs scripts/; prebuild fetches GitHub releases (network required)
RUN npm ci

COPY . .
ENV VITE_BASE_PATH=/
# Build-time auth toggles baked into the SPA. Default off to preserve existing
# behavior; the Coolify preview sets VITE_AUTH_LOCAL=true so the dev realm's
# seeded accounts (dev-admin etc.) can sign in via "Sign in with local account".
ARG VITE_AUTH_LOCAL=false
ENV VITE_AUTH_LOCAL=${VITE_AUTH_LOCAL}
# the vite build with sourcemaps needs more heap than the node default
ENV NODE_OPTIONS=--max-old-space-size=4096
RUN npm run build

FROM nginx:alpine
COPY deploy/nginx-web.conf /etc/nginx/conf.d/default.conf
COPY --from=build /app/build /usr/share/nginx/html
EXPOSE 80
